<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/orange" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:left="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/device_bg" />
            <corners android:topRightRadius="12dp" android:bottomRightRadius="12dp"
                android:topLeftRadius="0dp" android:bottomLeftRadius="0dp" />
            <stroke android:width="1dp" android:color="@color/border3" />
        </shape>
    </item>
</layer-list>
