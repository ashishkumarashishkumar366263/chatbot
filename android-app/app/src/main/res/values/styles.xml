<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@color/header_bg</item>
        <item name="android:navigationBarColor">@color/header_bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorAccent">@color/orange</item>
    </style>

    <style name="CardHeading">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/grey</item>
        <item name="android:textSize">13sp</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:layout_marginBottom">12dp</item>
        <item name="android:paddingBottom">5dp</item>
        <item name="android:textAllCaps">true</item>
    </style>
</resources>
